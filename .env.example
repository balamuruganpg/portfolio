# Copy to .env.local. Never commit .env.local or use NEXT_PUBLIC_ for keys.
# The public assistant uses server-side credentials only; no visitor key form.
GROQ_API_KEY=
# Optional; Groq fallback uses openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-120b
# Existing optional alternate providers:
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
